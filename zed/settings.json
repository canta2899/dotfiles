// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
    "auto_install_extensions": {
        "catppuccin": true,
        "vscode-icons-nestjs": true,
        "kanagawa-themes": true,
    },
    "indent_guides": {
        "line_width": 1,
    },
    "tab_size": 4,
    "vim": {
        "gdefault": true,
        "use_smartcase_find": false,
        "toggle_relative_line_numbers": true,
    },
    "icon_theme": "VSCode Icons for Zed (Dark NestJS)",
    "cli_default_open_behavior": "existing_window",
    "edit_predictions": {
        "provider": "copilot",
    },
    "agent": {
        "dock": "right",
        "sidebar_side": "left",
        "favorite_models": [],
        "model_parameters": [],
    },
    "project_panel": {
        "git_status_indicator": true,
        "diagnostic_badges": true,
        "dock": "left",
    },
    "format_on_save": "on",
    "prettier": {
        "allowed": true,
    },
    "telemetry": {
        "diagnostics": true,
        "metrics": true,
        "anthropic_retention": false,
    },
    "vim_mode": true,
    "terminal": {
        "font_size": 15.0,
        "font_family": "Hack Nerd Font Mono",
    },
    "git": {
        "inline_blame": {
            "enabled": true,
        },
    },
    "base_keymap": "VSCode",
    "minimap": {
        "show": "always",
    },
    "buffer_font_fallbacks": ["Droid Sans Mono", "monospace"],
    "buffer_font_family": "Hack Nerd Font Mono",
    "soft_wrap": "editor_width",
    "agent_servers": {
        "github-copilot-cli": {
            "type": "registry",
        },
        "claude-acp": {
            "default_config_options": {
                "model": "opus",
                "fast": false,
            },
            "type": "registry",
        },
    },
    "ui_font_size": 16,
    "buffer_font_size": 15,
    "theme": "Kanagawa Dragon",
}
