// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
    {
        "context": "Workspace",
        "bindings": {
            // "shift shift": "file_finder::Toggle"
        },
    },
    {
        "context": "Editor && vim_mode == insert",
        "bindings": {
            // "j k": "vim::NormalBefore"
        },
    },
    {
        "context": "vim_mode == normal",
        "bindings": {
            "ctrl-d": ["workspace::SendKeystrokes", "ctrl-d z z"],
            "ctrl-u": ["workspace::SendKeystrokes", "ctrl-u z z"],
            "s": ["workspace::SendKeystrokes", "\" _ s"],
            "shift-s": ["workspace::SendKeystrokes", "\" _ shift-s"],
            "c": ["workspace::SendKeystrokes", "\" _ c"],
            "shift-c": ["workspace::SendKeystrokes", "\" _ shift-c"],
        },
    },
    {
        "context": "vim_mode == visual",
        "bindings": {
            "shift-s": ["workspace::SendKeystrokes", "\" _ shift-s"],
            "p": ["workspace::SendKeystrokes", "\" _ d shift-p"],
            "shift-p": ["workspace::SendKeystrokes", "\" _ d shift-p"],
        },
    },
    {
        "context": "Dock || Terminal || (Editor && (vim_mode == normal || vim_mode == visual))",
        "bindings": {
            "ctrl-h": "workspace::ActivatePaneLeft",
            "ctrl-l": "workspace::ActivatePaneRight",
            "ctrl-k": "workspace::ActivatePaneUp",
            "ctrl-j": "workspace::ActivatePaneDown",
        },
    },
    {
        "context": "Terminal",
        "bindings": {
            "ctrl-l": ["terminal::SendKeystroke", "ctrl-l"],
        },
    },
    {
        "context": "Workspace",
        "bindings": {
            "ctrl-j": "terminal_panel::ToggleFocus",
        },
    },
]
